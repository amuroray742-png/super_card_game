# 服务端环境变量示例。复制为 `.env` 后按需修改（.env 已被 .gitignore 忽略）。
#
# 优先级：命令行参数 > 环境变量 > 默认值。
#   npm run server:start -- --port 9000 --db /tmp/x.db

# JWT 签名密钥。**生产环境必须改**：重置后所有已登录设备的会话立即失效。
# 生成方式：node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SGW_JWT_SECRET=dev-only-secret-change-me

# 监听地址与端口
SGW_HOST=127.0.0.1
SGW_PORT=8787

# SQLite 数据文件路径（目录会自动创建）
SGW_DB_PATH=server/data/app.db

# 允许跨域的前端来源，逗号分隔
SGW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# 前端：后端地址（localStorage 的 `sgw.apiBase` 优先级更高）
VITE_API_BASE=http://127.0.0.1:8787
