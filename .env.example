# 服务端环境变量示例。复制为 `.env` 后按需修改（.env 已被 .gitignore 忽略）。
#
# ⚠ **`.env` 现在是真的会被加载**：`npm run server:start` / `server:dev`
#   都带 `--env-file-if-exists=.env`（Node 24 原生支持，无需 dotenv 依赖）。
#   文件不存在时静默跳过；命令行参数仍然优先于环境变量。
#
#   生成一个像样的密钥：
#     node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"

# ── 生产必填 ────────────────────────────────────────────────
# JWT 签名密钥。**生产环境必须改**：重置后所有已登录设备的会话立即失效。
# `NODE_ENV=production` 且仍是默认密钥时，服务端会**拒绝启动**。
SGW_JWT_SECRET=dev-only-secret-change-me
NODE_ENV=development

# ── 监听地址与端口 ───────────────────────────────────────────
SGW_HOST=127.0.0.1
SGW_PORT=8787

# ── SQLite 数据文件路径（目录会自动创建）──────────────────────
# 容器部署里是挂载卷的路径（见 docker-compose.yml）。
SGW_DB_PATH=server/data/app.db

# ── 令牌有效期（秒）──────────────────────────────────────────
# access token 短一些（泄漏窗口小），refresh token 长一些（少打扰玩家）。
SGW_ACCESS_TOKEN_TTL=900
SGW_REFRESH_TOKEN_TTL=2592000

# ── 允许跨域的前端来源，逗号分隔 ─────────────────────────────
# 同源部署（nginx 反代 /api）时**不需要**这一项，留空即可。
SGW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ── 前端构建变量 ─────────────────────────────────────────────
# 后端地址（localStorage 的 `sgw.apiBase` 优先级更高）。
# 生产构建用**相对路径** `/api` → 同一份构建在任何域名下都指向同源（厂商中立）。
VITE_API_BASE=http://127.0.0.1:8787

# ── 运维联系方式（合规页展示）────────────────────────────────
# 玩家在合规页看到的客服 / 运营邮箱。发布前**必须**填成真实地址。
VITE_CONTACT_EMAIL=
